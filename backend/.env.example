# Hugging Face Inference API Token (Used for QA, NER, Sentiment, Summarize, Translate)
# Get yours for free at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_generated_token_here

# Google Gemini API Key (Used for Text Generation)
# Get yours for free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
